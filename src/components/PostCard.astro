---
import type { CollectionEntry } from 'astro:content';
import Shape from './Shape.astro';
import { formatDate, useT, type Lang } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = useT(lang);
const { kind, date, title, summary, color, image, imageAlt } = post.data;

const fallbackShape = { saffron: 'sun', pomegranate: 'pomegranate', firuzeh: 'fish' } as const;
---

<article class={`post-card tone-${color}`}>
  <div class="post-art">
    {image ? (
      <img src={image} alt={imageAlt ?? ''} loading="lazy" />
    ) : (
      <Shape name={fallbackShape[color]} />
    )}
    <span class="pill">{kind === 'event' ? t('kind.event') : t('kind.news')}</span>
  </div>
  <div class="post-body">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
    <h3>{title[lang]}</h3>
    <p>{summary[lang]}</p>
  </div>
</article>
