---
import Base from '../../layouts/Base.astro';
import Shape from '../../components/Shape.astro';
import { langs, useT, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
---

<Base lang={lang} title={t('thanks.title')}>
  <section class="section page-top thanks">
    <Shape name="sun" class="thanks-sun" />
    <h1>{t('thanks.title')}</h1>
    <p>{t('thanks.text')}</p>
    <a class="btn" href={`/${lang}/`}>{t('thanks.back')}</a>
  </section>
</Base>
